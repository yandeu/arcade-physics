{
  "name": "arcade-physics",
  "version": "0.2.0",
  "description": "Standalone 2D Arcade Physics for JavaScript games, based on Phaser's Arcade Physics. Supports AABB and circle bodies, collisions, overlaps, and tilemaps.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "init": "git submodule update --init",
    "build": "node scripts/removeDevice.mjs && node scripts/build.mjs && node scripts/types.mjs",
    "prepack": "npm run build",
    "test": "node --test ./test/*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1"
  },
  "author": "Yannick Deubel (https://github.com/yandeu)",
  "license": "MIT",
  "keywords": [
    "2d",
    "arcade",
    "physics",
    "phaser",
    "phaser-physics",
    "game-physics",
    "collision-detection",
    "tilemap",
    "game-development",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yandeu/arcade-physics.git"
  },
  "bugs": {
    "url": "https://github.com/yandeu/arcade-physics/issues"
  },
  "homepage": "https://github.com/yandeu/arcade-physics#readme"
}